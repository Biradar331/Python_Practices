{
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "python-envs.pythonProjects": [],
    "github.copilot.nextEditSuggestions.enabled": true,
    "github.copilot.nextEditSuggestions.allowWhitespaceOnlyChanges": true,
